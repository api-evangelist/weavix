          "name": "Get results from a specific form",
          "request": {
            "name": "Get results from a specific form",
            "description": {
              "content": "Retrieves all submissions for a specific form. Each result includes the id of the submitting user, correlatable to a user via getUser.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "core",
                "forms",
                ":formId",
                "submissions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "formId",
                  "description": "(Required) The form id, found at the end of the form URL in the weavix Console."
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
          "response": [
            {
