{
  "opencollection": "1.0.0",
  "info": {
    "name": "weavix REST Channels & Messaging Geofences API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Geofences",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of all geofences",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.weavix.com/track/geofences"
          },
          "docs": "Returns a list of all the geofences on your account. Filter by facilityId to find geofences that belong to a site."
        }
      ]
    }
  ],
  "bundled": true
}